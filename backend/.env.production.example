# PRODUCTION template. Copy to .env on the server and fill in real values.
# Never commit the filled-in file.
#
# Why this file exists: the development .env that shipped with the repo had
# ENVIRONMENT=development, DEBUG=true and LOGIN_RATE_LIMIT_ATTEMPTS=5000 over
# a 1-second window. Deployed as-is that would publish /docs, echo every SQL
# statement and its parameters into the logs, and leave password login
# effectively unthrottled. Start from this file instead.

# --- App ---
APP_NAME="Vishakan Field Force"
# Gates /docs and /redoc off, and is checked in several places. Must be
# exactly "production".
ENVIRONMENT=production
# Controls SQLAlchemy echo. Leaving this true writes every query, with its
# bound parameters, to the application log.
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Security / Auth ---
# A freshly generated key is filled in below, so this file is usable as-is.
# It travelled to you through a chat and a zip, though, so if you want a key
# that has never left the server, replace it there with:
#   openssl rand -hex 32
# Rotating it signs every existing session out, which is harmless before
# launch and worth knowing about afterwards.
JWT_SECRET_KEY=15e296382b02ed9991d9ed7255d88518b0adeedf22a9dd3159e54df59a995f7e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# The admin portal's real origin(s). Do not use "*" - the API is
# credentialed, and a wildcard would let any site call it with a user's token.
CORS_ALLOWED_ORIGINS=["https://portal.vishakanbiotech.com"]

# --- Rate limiting ---
# Five attempts per five minutes per account. This is the brute-force guard on
# password login; raising it or shortening the window turns it off.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Per-IP backstop over the same window. Only FAILED sign-ins count toward these,
# so normal use - even a whole district behind one carrier NAT - never spends from them.
LOGIN_IP_RATE_LIMIT_ATTEMPTS=100

# --- Database ---
POSTGRES_USER=vishakan_ffm
# Generated. Set the same value on the Postgres service.
POSTGRES_PASSWORD=7e88c184c30965d3ae8a97a2c3f5b9cd8b6b9e035866f552
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vishakan_ffm

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Set a password and keep Redis off the public network: it holds live officer
# locations and refresh-token state.
REDIS_PASSWORD=

# --- Company-local time ---
# Every "today" in the app resolves in this zone, not UTC. Rows stay in UTC.
COMPANY_TIMEZONE=Asia/Kolkata

# --- Logging ---
LOG_LEVEL=INFO
