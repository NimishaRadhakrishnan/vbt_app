# Copy to .env and fill in real values. Never commit the real .env file.
#
# For a PRODUCTION deployment see .env.production.example instead - the
# defaults below are for a developer laptop and are deliberately permissive.

# --- App ---
APP_NAME="Vishakan Field Force"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Per-IP backstop over the same window. Only FAILED sign-ins count toward these,
# so normal use - even a whole district behind one carrier NAT - never spends from them.
LOGIN_IP_RATE_LIMIT_ATTEMPTS=100

# --- Database ---
POSTGRES_USER=vishakan_ffm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vishakan_ffm

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Company-local time ---
# Every "today" in the app (day closures, rosters, visit counts, plan weeks)
# resolves in this zone, not UTC. Rows are still stored in UTC.
COMPANY_TIMEZONE=Asia/Kolkata

# --- Logging ---
LOG_LEVEL=INFO
